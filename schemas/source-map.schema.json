{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-test.local/schemas/source-map.schema.json",
  "title": "Better Test Source Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "generated_at", "provider", "source", "native_assets", "units", "risk_units", "checks", "edges", "provider_metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "type", "identity"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "type": {"const": "source"},
        "identity": {
          "type": "object",
          "required": ["vcs", "commit", "dirty"],
          "properties": {
            "vcs": {"enum": ["git", "none"]},
            "commit": {"type": "string", "minLength": 1},
            "dirty": {"type": "boolean"},
            "worktree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "dirty_scope": {"type": "array", "items": {"enum": ["staged", "unstaged", "untracked"]}}
          },
          "allOf": [{"if": {"properties": {"dirty": {"const": true}}}, "then": {"required": ["worktree_fingerprint", "dirty_scope"]}}]
        }
      }
    },
    "native_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "units": {"$ref": "#/$defs/units"},
    "risk_units": {"$ref": "#/$defs/units"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "command", "subject_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "subject_type": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"},
        "provider_metadata": {"type": "object"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}
      }
    },
    "provider_metadata": {"type": "object"}
  },
  "$defs": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "owner": {"type": "string"},
          "provider_metadata": {"type": "object"}
        }
      }
    }
  }
}
