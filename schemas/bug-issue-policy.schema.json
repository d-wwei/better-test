{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-test.local/schemas/bug-issue-policy.schema.json",
  "title": "Better Test Bug Issue Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "repository",
    "enabled",
    "eligible_statuses",
    "eligible_evidence_levels",
    "labels",
    "require_submission_key",
    "require_full_report",
    "require_results_validation",
    "title_template"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "provider": {
      "const": "github"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "eligible_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["OPEN", "CONFIRMED"]
      }
    },
    "eligible_evidence_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["confirmed", "proven"]
      }
    },
    "labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "require_submission_key": {
      "type": "boolean"
    },
    "require_full_report": {
      "type": "boolean"
    },
    "require_results_validation": {
      "type": "boolean"
    },
    "title_template": {
      "type": "string",
      "minLength": 1
    },
    "body_preamble": {
      "type": "string",
      "minLength": 1
    },
    "report_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/]+$"
      }
    },
    "ledger_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+$"
    },
    "max_body_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65000
    },
    "project_profile": {
      "type": "string",
      "minLength": 1
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_emails": {
          "type": "boolean"
        },
        "block_nonlocal_ips": {
          "type": "boolean"
        },
        "additional_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "pattern"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
