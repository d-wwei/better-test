{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-test.local/schemas/intake.schema.json",
  "title": "Better Test Run Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_id",
    "produced_by",
    "attested_at",
    "subjects",
    "relations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "intake_id": {"type": "string", "minLength": 1},
    "produced_by": {"type": "string", "minLength": 1},
    "attested_at": {"type": "string", "format": "date-time"},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "identity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "source",
              "build",
              "artifact",
              "installation",
              "process",
              "session",
              "external_service",
              "unknown"
            ]
          },
          "identity": {"type": "object"},
          "provider_metadata": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "source"}}, "required": ["type"]},
            "then": {
              "properties": {
                "identity": {
                  "required": ["commit", "dirty"],
                  "properties": {
                    "commit": {"type": "string", "minLength": 1},
                    "dirty": {"type": "boolean"},
                    "worktree_fingerprint": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "build"}}, "required": ["type"]},
            "then": {
              "properties": {
                "identity": {
                  "required": [
                    "source_ref",
                    "toolchain",
                    "lock_sha256",
                    "features",
                    "profile",
                    "output_sha256"
                  ],
                  "properties": {
                    "source_ref": {"type": "string", "minLength": 1},
                    "toolchain": {"type": "string", "minLength": 1},
                    "lock_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "features": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "profile": {"type": "string", "minLength": 1},
                    "output_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "artifact"}}, "required": ["type"]},
            "then": {
              "properties": {
                "identity": {
                  "required": ["sha256"],
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "path": {"type": "string", "minLength": 1},
                    "path_base": {
                      "enum": ["project_root", "run_dir"]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "installation"}}, "required": ["type"]},
            "then": {
              "properties": {
                "identity": {
                  "required": ["install_id", "installed_executable_sha256"],
                  "properties": {
                    "install_id": {"type": "string", "minLength": 1},
                    "installed_executable_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "process"}}, "required": ["type"]},
            "then": {
              "properties": {
                "identity": {
                  "required": ["pid", "executable_sha256", "started_at"],
                  "properties": {
                    "pid": {"type": "integer", "minimum": 1},
                    "executable_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "started_at": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"type": {"const": "session"}}, "required": ["type"]},
            "then": {
              "properties": {
                "identity": {
                  "required": ["session_id", "readiness"],
                  "properties": {
                    "session_id": {"type": "string", "minLength": 1},
                    "readiness": {"enum": ["ready", "not_ready", "unknown"]}
                  }
                }
              }
            }
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "from", "to", "evidence_refs"],
        "properties": {
          "type": {
            "enum": [
              "built_from",
              "produced_by",
              "installed_from",
              "launched_from",
              "connected_to",
              "observed_by"
            ]
          },
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
