{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-test.local/schemas/test-design.schema.json",
  "title": "Better Test optional case contract v1 (design metadata only)",
  "type": "object",
  "required": ["case_id", "revision", "requirements", "features", "entries", "risk", "preconditions", "input_fixture", "actions", "expected", "oracle_ref", "runner_ref", "environment_ref", "cleanup_ref", "evidence_required"],
  "properties": {
    "case_id": {"$ref": "#/$defs/nonempty"},
    "revision": {"type": "integer", "minimum": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "features": {"$ref": "#/$defs/strings"},
    "entries": {"$ref": "#/$defs/strings"},
    "risk": {
      "type": "object",
      "required": ["failure", "priority"],
      "properties": {
        "failure": {"$ref": "#/$defs/nonempty"},
        "priority": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "preconditions": {"$ref": "#/$defs/strings"},
    "input_fixture": {"$ref": "#/$defs/reference"},
    "actions": {"$ref": "#/$defs/strings"},
    "expected": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["observe", "relation"],
        "properties": {
          "observe": {"$ref": "#/$defs/nonempty"},
          "relation": {"$ref": "#/$defs/nonempty"},
          "value": {},
          "oracle_ref": {"$ref": "#/$defs/reference"}
        }
      }
    },
    "oracle_ref": {"$ref": "#/$defs/reference"},
    "runner_ref": {"$ref": "#/$defs/reference"},
    "environment_ref": {"$ref": "#/$defs/reference"},
    "cleanup_ref": {"$ref": "#/$defs/reference"},
    "evidence_required": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "strings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
    "reference": {
      "anyOf": [
        {"$ref": "#/$defs/nonempty"},
        {
          "type": "object", "required": ["status", "reason"], "additionalProperties": false,
          "properties": {
            "status": {"type": "string", "enum": ["unresolved", "not_applicable"]},
            "reason": {"$ref": "#/$defs/nonempty"}
          }
        }
      ]
    }
  }
}
