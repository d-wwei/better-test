{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-test.local/schemas/merged-results-v4.schema.json",
  "title": "Better Test Merged Results v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_type", "contract_version", "version",
    "merge_id", "coordinator_id", "merged_at", "source_runs", "subjects",
    "relations", "items", "gates", "summary", "max_claim_scope",
    "caveat_overrides", "release_readiness", "verdict_challenge"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "document_type": {"const": "better-test-merged-results"},
    "contract_version": {"const": "1.0.0"},
    "version": {"type": "string", "minLength": 1},
    "merge_id": {"type": "string", "minLength": 1},
    "coordinator_id": {"type": "string", "minLength": 1},
    "merged_at": {"type": "string", "format": "date-time"},
    "source_runs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/source_run"}
    },
    "subjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_subject"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_relation"}
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/merged_item"}
    },
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/merged_gate"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "max_claim_scope": {"type": "string", "minLength": 1},
    "caveat_overrides": {
      "type": "array",
      "items": {"$ref": "#/$defs/caveat_override"}
    },
    "supersessions": {
      "type": "array",
      "items": {"$ref": "#/$defs/supersession"}
    },
    "gate_supersessions": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate_supersession"}
    },
    "release_readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "reason", "source_verdicts"],
      "properties": {
        "verdict": {"enum": ["go", "no-go", "blocked", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "source_verdicts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source_run", "verdict", "reason"],
            "properties": {
              "source_run": {"type": "string", "minLength": 1},
              "verdict": {"enum": ["go", "no-go", "blocked", "not_applicable"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "verdict_challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["drafted_by", "challenger", "reviewed_at", "unresolved_count", "reason"],
      "properties": {
        "drafted_by": {"type": "string", "minLength": 1},
        "challenger": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "source_run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "schema_version", "version", "results_path", "sha256"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "schema_version": {"const": 4},
        "version": {"type": "string", "minLength": 1},
        "results_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["source_run", "subject"],
      "properties": {
        "source_run": {"type": "string", "minLength": 1},
        "subject": {"type": "object"}
      }
    },
    "source_relation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_run", "relation"],
      "properties": {
        "source_run": {"type": "string", "minLength": 1},
        "relation": {"type": "object"}
      }
    },
    "source_occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_run", "item"],
      "properties": {
        "source_run": {"type": "string", "minLength": 1},
        "item": {"type": "object"}
      }
    },
    "merged_item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "result", "occurrences"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "pass_with_caveat", "pass_known_legacy_behavior", "fail", "blocked", "partial", "skip", "excluded", "conflict"]},
        "occurrences": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/source_occurrence"}
        },
        "conflict_details": {"type": "string", "minLength": 1}
      }
    },
    "source_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["source_run", "gate"],
      "properties": {
        "source_run": {"type": "string", "minLength": 1},
        "gate": {"type": "object"}
      }
    },
    "merged_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "verdict", "occurrences"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["pass", "fail", "blocked", "skip", "not_applicable", "conflict"]},
        "occurrences": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/source_gate"}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "passed_unconditional", "passed_with_caveat", "passed_known_legacy_behavior", "failed", "blocked", "partial", "skipped", "excluded", "conflicts"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "passed_unconditional": {"type": "integer", "minimum": 0},
        "passed_with_caveat": {"type": "integer", "minimum": 0},
        "passed_known_legacy_behavior": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0}
      }
    },
    "caveat_override": {
      "type": "object", "additionalProperties": false,
      "required": ["source_run", "item_id", "approved_by", "approved_at", "reason"],
      "properties": {
        "source_run": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "supersession": {
      "type": "object", "additionalProperties": false,
      "required": [
        "item_id", "superseded_source_run", "authoritative_source_run",
        "approved_by", "approved_at", "reason"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "superseded_source_run": {"type": "string", "minLength": 1},
        "authoritative_source_run": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gate_supersession": {
      "type": "object", "additionalProperties": false,
      "required": [
        "gate_id", "superseded_source_run", "authoritative_source_run",
        "approved_by", "approved_at", "reason"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "superseded_source_run": {"type": "string", "minLength": 1},
        "authoritative_source_run": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
